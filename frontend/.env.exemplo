# Copie este arquivo para ".env" (o .env NÃO vai para o Git).
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Endereço da API em Node (FatoBot). Na Vercel, deixe /api
API_URL=/api
# Chat do Tawk.to (painel do tawk.to → Administration → Chat Widget). Vazio = o chat não aparece.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
